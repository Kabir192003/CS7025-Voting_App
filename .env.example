# Copy to .env and fill in. Nothing here has a default: the server refuses to start without it.
NODE_ENV=development
PORT=4000

# Postgres connection string. For Supabase use the SESSION POOLER string from
# Project Settings > Database > Connection string (works from Render and other IPv4 hosts):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Remote databases are always encrypted. To also verify the server certificate, download the
# CA from Supabase > Project Settings > Database > SSL Configuration, and give its path or PEM here.
DB_SSL_CA=

# At least 32 characters: openssl rand -hex 32
JWT_SECRET=

# 1 when behind a reverse proxy such as Render, so rate limits see real client IPs
TRUST_PROXY=0
# Set to 1 to apply pending migrations on boot (otherwise run: npm run migrate)
AUTO_MIGRATE=0
